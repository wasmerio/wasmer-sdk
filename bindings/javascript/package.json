{
  "name": "@wasmer/sdk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "pkg"],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:ts && node --test test/node-network.test.mjs test/runtime.test.mjs test/multi-worker.test.mjs",
    "test:runtime": "npm run build:ts && node --test test/runtime.test.mjs",
    "test:workers": "npm run build:ts && node --test test/multi-worker.test.mjs",
    "test:edgejs": "npm run build:ts && node --test test/edgejs-http.test.mjs",
    "test:postgres": "npm run build:ts && node --test test/postgres-psql.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
