@@ -136,6 +136,62 @@ mod tests {
     use wasm_bindgen_test::wasm_bindgen_test;
     use wasmer::{Memory, MemoryType, Module, SharedMemory, Store};
 
+    #[wasm_bindgen_test]
+    fn shared_object_deltas_are_per_connection_and_retry_failed_posts() {
+        let store = Store::default();
+        let first = Module::new(&store, b"\0asm\x01\0\0\0").unwrap();
+        let mut sender = wasmer::js::SharedObjectSender::default();
+        let prepare = || wasmer::js::prepare_shared_object_message(JsValue::from_str("task"));
+        let count = |value: &JsValue| Array::from(&Array::from(value).get(2)).length();
+        sender
+            .send(prepare(), |message| -> Result<(), JsValue> {
+                assert_eq!(count(message), 1);
+                assert_eq!(
+                    unsafe { wasmer::js::receive_shared_object_message(message.clone()) }?,
+                    "task"
+                );
+                Ok(())
+            })
+            .unwrap();
+        sender
+            .send(prepare(), |message| -> Result<(), JsValue> {
+                assert_eq!(count(message), 0);
+                Ok(())
+            })
+            .unwrap();
+
+        let second = Module::new(&store, b"\0asm\x01\0\0\0").unwrap();
+        assert!(
+            sender
+                .send(prepare(), |message| -> Result<(), JsValue> {
+                    assert_eq!(count(message), 1);
+                    Err(JsValue::from_str("postMessage failed"))
+                })
+                .is_err()
+        );
+        sender
+            .send(prepare(), |message| -> Result<(), JsValue> {
+                assert_eq!(count(message), 1);
+                Ok(())
+            })
+            .unwrap();
+
+        let mut replacement = wasmer::js::SharedObjectSender::default();
+        replacement
+            .send(prepare(), |message| -> Result<(), JsValue> {
+                assert_eq!(count(message), 2);
+                Ok(())
+            })
+            .unwrap();
+        drop((first, second));
+        sender
+            .send(prepare(), |message| -> Result<(), JsValue> {
+                assert_eq!(count(message), 0);
+                Ok(())
+            })
+            .unwrap();
+    }
+
