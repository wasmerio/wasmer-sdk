{
  "name": "@wasmer/sdk",
  "version": "0.1.0",
  "description": "A portable, package-first sandbox SDK powered by Wasmer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasmerio/wasmer-sdk.git",
    "directory": "js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:ts && node --test tests/validation.test.mjs && node --test --test-timeout=30000 tests/node-network.test.mjs && node --test --test-timeout=30000 tests/runtime.test.mjs && node --test --test-timeout=30000 tests/multi-worker.test.mjs",
    "test:runtime": "npm run build:ts && node --test --test-timeout=30000 tests/runtime.test.mjs",
    "test:workers": "npm run build:ts && node --test --test-timeout=30000 tests/multi-worker.test.mjs",
    "test:browser": "npm run build:ts && node --test --test-timeout=180000 tests/browser-python.test.mjs",
    "test:edgejs": "npm run build:ts && node --test --test-timeout=30000 tests/edgejs-http.test.mjs",
    "test:postgres": "npm run build:ts && node --test --test-timeout=90000 tests/postgres-psql.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
