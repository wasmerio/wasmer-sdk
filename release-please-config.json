{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "python": {
      "release-type": "python",
      "package-name": "wasmer-sdk",
      "component": "wasmer-sdk-python",
      "include-component-in-tag": true,
      "initial-version": "0.1.0"
    },
    "js": {
      "release-type": "node",
      "package-name": "@wasmer/sdk",
      "component": "wasmer-sdk-js",
      "include-component-in-tag": true,
      "initial-version": "0.11.0"
    },
    "swift": {
      "release-type": "simple",
      "package-name": "wasmer-sdk-swift",
      "component": "wasmer-sdk-swift",
      "include-component-in-tag": true,
      "initial-version": "0.2.1"
    }
  },
  "draft": true,
  "force-tag-creation": true
}
