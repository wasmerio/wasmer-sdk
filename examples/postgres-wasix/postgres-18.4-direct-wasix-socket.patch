+/*
+ * Serve one PostgreSQL frontend directly from a WASIX TCP socket.
+ *
+ * This deliberately preserves the embedded one-backend execution model.  The
+ * socket is created, bound, listened on, and accepted by the guest process;
+ * there is no native protocol proxy.  Set OLIPHAUNT_WASIX_SOCKET_PORT to opt
+ * into this command-mode entrypoint.
+ */
+static void
+oliphaunt_wasix_accept_socket_client(void)
+{
+	const char *port_text = getenv("OLIPHAUNT_WASIX_SOCKET_PORT");
+	char	   *port_end = NULL;
+	long		port_number;
+	int			server_fd;
+	int			reuse = 1;
+	struct sockaddr_in bind_addr;
+	ClientSocket client_sock;
+
+	if (port_text == NULL || port_text[0] == '\0')
+		return;
+
+	errno = 0;
+	port_number = strtol(port_text, &port_end, 10);
+	if (errno != 0 || port_end == port_text || *port_end != '\0' ||
+		port_number < 1 || port_number > 65535)
+		ereport(FATAL,
+				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+				 errmsg("invalid OLIPHAUNT_WASIX_SOCKET_PORT: \"%s\"",
+						port_text)));
+
+	server_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (server_fd == PGINVALID_SOCKET)
+		ereport(FATAL,
+				(errcode_for_socket_access(),
+				 errmsg("could not create WASIX server socket: %m")));
+
+	(void) setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
+					  (char *) &reuse, sizeof(reuse));
+
+	memset(&bind_addr, 0, sizeof(bind_addr));
+	bind_addr.sin_family = AF_INET;
+	bind_addr.sin_port = htons((unsigned short) port_number);
+	bind_addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+	if (bind(server_fd, (struct sockaddr *) &bind_addr, sizeof(bind_addr)) < 0)
+		ereport(FATAL,
+				(errcode_for_socket_access(),
+				 errmsg("could not bind WASIX server socket on port %ld: %m",
+						port_number)));
+	if (listen(server_fd, 1) < 0)
+		ereport(FATAL,
+				(errcode_for_socket_access(),
+				 errmsg("could not listen on WASIX server socket: %m")));
+
+	fprintf(stderr, "OLIPHAUNT_WASIX_SOCKET_READY %ld\n", port_number);
+	fflush(stderr);
+
+	memset(&client_sock, 0, sizeof(client_sock));
+	if (AcceptConnection(server_fd, &client_sock) != STATUS_OK)
+		ereport(FATAL,
+				(errcode_for_socket_access(),
+				 errmsg("could not accept WASIX PostgreSQL client")));
+	close(server_fd);
+
+	/*
+	 * pq_init() must see the true standalone state so it does not register a
+	 * nonexistent postmaster-death event.  Startup options and the normal
+	 * protocol loop then use the same backend-shaped flags as the embedded
+	 * host API.
+	 */
+	IsUnderPostmaster = false;
+	MyProcPort = pq_init(&client_sock);
+	MyProcPort->oliphaunt_wasix_io = NULL;
+	IsPostmasterEnvironment = true;
+	IsUnderPostmaster = true;
+	MyBackendType = B_BACKEND;
+	whereToSendOutput = DestRemote;
+	ExitOnAnyError = false;
+
+	if (ProcessStartupPacket(MyProcPort, false, false) != STATUS_OK)
+		proc_exit(0);
+
+	oliphaunt_wasix_send_conn_data();
+	pq_flush();
+	send_ready_for_query = false;
+	oliphaunt_wasix_socket_client_active = true;
 }
 
